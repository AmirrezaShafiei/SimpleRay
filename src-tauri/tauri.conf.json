{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleRay",
  "version": "0.5.0-beta.5",
  "identifier": "io.simpleray.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SimpleRay",
        "width": 960,
        "height": 620,
        "minWidth": 720,
        "minHeight": 490,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b1221",
        "decorations": false
      },
      {
        "label": "quick",
        "title": "SimpleRay Quick Switch",
        "url": "quick.html",
        "width": 366,
        "height": 470,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "backgroundColor": "#0e1727"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' http: https:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "binaries/xray.exe",
      "binaries/geoip.dat",
      "binaries/geosite.dat",
      "licenses/XRAY-LICENSE.txt"
    ]
  }
}
