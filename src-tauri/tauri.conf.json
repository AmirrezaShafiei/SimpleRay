{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleRay",
  "version": "0.1.0",
  "identifier": "io.simpleray.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [{"title":"SimpleRay · Phase 1 Preview","width":1320,"height":850,"minWidth":980,"minHeight":640,"center":true,"backgroundColor":"#0b1221"}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'"}
  },
  "bundle": {"active":true,"targets":["nsis"],"icon":["icons/icon.ico","icons/icon.png"]}
}
